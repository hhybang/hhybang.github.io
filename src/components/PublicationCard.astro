---
import type { Publication } from '../data/site';
interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
---

<article class="pub">
  {
    pub.image && (
      <div class="pub-thumb">
        <img src={pub.image} alt={pub.title} loading="lazy" />
      </div>
    )
  }
  <div class="pub-body">
    <h3 class="pub-title">{pub.title}</h3>
    <p class="pub-authors" set:html={pub.authors} />
    <p class="pub-venue">
      {pub.venue}, {pub.year}
      {pub.badge && <span class="pub-badge">{pub.badge}</span>}
    </p>
    {
      pub.links.length > 0 && (
        <div class="pub-links">
          {pub.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    margin: 0 -1.5rem;
    border-radius: var(--radius);
    border-bottom: 1px solid var(--border);
    transition: transform 0.22s ease, box-shadow 0.22s ease,
      background-color 0.22s ease;
  }
  .pub:last-child {
    border-bottom: none;
  }
  .pub:hover {
    transform: translateY(-3px);
    background: var(--bg-subtle);
    box-shadow: var(--shadow-lift);
    border-bottom-color: transparent;
  }
  .pub-thumb {
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    align-self: start;
  }
  .pub-thumb img {
    width: 100%;
    display: block;
    background: var(--bg-subtle);
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .pub:hover .pub-thumb img {
    transform: scale(1.06);
  }
  .pub:hover .pub-title {
    color: var(--accent);
  }
  .pub-title {
    transition: color 0.2s ease;
  }
  .pub-title {
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }
  .pub-authors {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 0.15rem;
  }
  .pub-authors :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .pub-venue {
    font-size: 0.85rem;
    color: var(--text-faint);
    font-style: italic;
    margin-bottom: 0.7rem;
  }
  .pub-badge {
    display: inline-block;
    margin-left: 0.5rem;
    font-style: normal;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.1rem 0.5rem;
    border-radius: 99px;
    vertical-align: middle;
  }
  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pub-links a {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.22rem 0.7rem;
    border-radius: 99px;
    transition: all 0.15s ease;
  }
  .pub-links a:hover {
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
  }

  @media (max-width: 560px) {
    .pub {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .pub-thumb {
      max-width: 280px;
    }
  }
</style>
