---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>© {year} {site.name}</span>
    <span class="dot">·</span>
    <span>Built with <a href="https://astro.build">Astro</a></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }
  .footer-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 1.5rem;
    font-size: 0.82rem;
    color: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .footer-inner a {
    color: var(--text-muted);
  }
  .dot {
    opacity: 0.5;
  }
</style>
